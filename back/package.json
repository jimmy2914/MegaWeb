{
  "name": "megaprojects-back",
  "version": "0.0.1",
  "description": "NestJS backend para MegaWeb",
  "scripts": {
    "prestart": "lsof -ti tcp:3000 | xargs -r kill -9",
    "prestart:dev": "lsof -ti tcp:3000 | xargs -r kill -9",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint '{src,test}/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "db:migrate": "prisma migrate dev --name init_database",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@prisma/client": "4.16.2",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.22",
    "@nestjs/schematics": "^11.0.5",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.19",
    "@types/node": "^20.14.2",
    "@types/passport-jwt": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.0.0",
    "prisma": "4.16.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "@nestjs/testing": "^11.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "@types/jest": "^29.5.12"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
